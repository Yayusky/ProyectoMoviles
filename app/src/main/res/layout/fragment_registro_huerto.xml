<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Registra un nuevo Huerto"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            />

        <ImageView
            android:id="@+id/imagenRegistro"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ic_launcher_background">
        </ImageView>

        <!-- Campo: Nombre del huerto -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintTextColor="@color/design_default_color_secondary"
            android:hint="Nombre del Huerto"
            android:layout_marginTop="10dp"

            >
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/nombreHuerto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- Campo: CantidadPlantas -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintTextColor="@color/design_default_color_secondary"
            android:hint="Cantidad de plantas"
            android:layout_marginTop="10dp"

            >
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/cantidadPlantas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- Campo: notas -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintTextColor="@color/design_default_color_secondary"
            android:hint="Notas(opcional)"
            android:layout_marginTop="10dp"
            >
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/notasHuerto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                />

        </com.google.android.material.textfield.TextInputLayout>



        <LinearLayout
            android:id="@+id/layout_tipo_suelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloTipoSuelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de suelo"
                android:textStyle="bold"
                android:textSize="14dp"
                android:textColor="@android:color/black"
                android:layout_gravity=""
                />

            <!-- Contenido (solo lectura) -->
            <TextView
                android:id="@+id/TipoSuelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(se llenará según la planta)"
                android:textSize="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

<!--        <EditText-->
<!--            android:id="@+id/tipoRiego"-->
<!--            android:hint="Tipo de riego"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content" />-->

        <LinearLayout
            android:id="@+id/layout_tipo_riego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Numero de Riegos por semana"
                android:textStyle="bold"
                android:textSize="14dp"
                android:textColor="@android:color/black" />

            <!-- Contenido (solo lectura) -->
            <TextView
                android:id="@+id/frecuenciaRiego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(se llenará según la planta)"
                android:textSize="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sobres de Semillas recomendados"
                android:textStyle="bold"
                android:textSize="14dp"
                android:textColor="@android:color/black" />

            <!-- Contenido (solo lectura) -->
            <TextView
                android:id="@+id/sobresRecomendos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(se llenará según la planta)"
                android:textSize="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />
        </LinearLayout>


        <Button
            android:id="@+id/btnRegistrarHuerto"
            android:text="Registrar huerto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#68B165"
            android:textColor="#fff" />

        <Button
            android:id="@+id/btnCancelarRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#68B165"
            android:layout_marginTop="10dp"
            android:textColor="#fff"
            android:text="Cancelar" />





    </LinearLayout>
</ScrollView>
