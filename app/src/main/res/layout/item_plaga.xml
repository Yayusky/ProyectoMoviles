<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#ffff"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imagePlaga"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"

            android:scaleType="centerCrop"
            android:background="@drawable/ic_launcher_background"
            android:contentDescription="Imagen de la plaga" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textTituloPlaga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="dsfadsfasdfsdaf"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/textNombreCientifico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sdfdsafdsfasd"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textStyle="italic"
                android:layout_marginTop="4dp" />


            <TextView
                android:id="@+id/textDescripcionPlaga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="asdasdasdasd"
                android:textSize="14sp"
                android:textColor="#757575"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/textRemediosDisponibles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="asdasdasdas"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>